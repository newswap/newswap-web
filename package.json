{
  "name": "newswap-web-react-next",
  "private": true,
  "description": "newswap.org website",
  "version": "0.7.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:testnet": "dotenv -e .env.testnet -- next dev --webpack",
    "dev:production": "dotenv -e .env.production -- next dev --webpack",
    "build:dev": "dotenv -e .env -- next build --webpack",
    "build:testnet": "dotenv -e .env.testnet -- next build --webpack",
    "build:production": "dotenv -e .env.production -- next build --webpack",
    "build": "dotenv -e .env.testnet -- next build --webpack",
    "start": "next start",
    "export:dev": "cross-env NEXT_STATIC_EXPORT=1 dotenv -e .env -- next build --webpack",
    "export:testnet": "cross-env NEXT_STATIC_EXPORT=1 dotenv -e .env.testnet -- next build --webpack",
    "export:production": "cross-env NEXT_STATIC_EXPORT=1 dotenv -e .env.production -- next build --webpack",
    "export": "cross-env NEXT_STATIC_EXPORT=1 dotenv -e .env.testnet -- next build --webpack",
    "lint": "eslint .",
    "fc": "prettier --check .",
    "ff": "prettier --write ."
  },
  "dependencies": {
    "bootstrap": "4.5.2",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^11.0.0",
    "gray-matter": "^4.0.2",
    "i18next": "26.7.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "next": "16.4.5",
    "react": "18.3.1",
    "react-bootstrap": "1.6.8",
    "react-dom": "18.3.1",
    "react-i18next": "17.1.13",
    "react-scroll": "^1.9.3",
    "remark": "^13.0.0",
    "remark-html": "^13.0.1",
    "remark-parse": "^9.0.0",
    "remark-react": "^8.0.0",
    "swiper": "14.4.0",
    "unified": "^9.2.0"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.6.2",
    "@eslint/js": "^9.39.0",
    "cross-env": "^10.1.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@10.9.9"
}
